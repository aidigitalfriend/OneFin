{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onefin",
  "main": "worker.ts",
  "compatibility_date": "2026-11-08",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/create-checkout-session"]
  },
  "vars": {
    "APP_URL": "https://onefinsolution.xyz"
  }
}
