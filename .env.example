# APP_URL: The custom domain where this applet is hosted.
APP_URL="https://onefinsolution.xyz"

# Server-only Cloudflare Worker bindings. Never prefix Stripe secrets with VITE_.
# Use the matching test/sandbox account first; see STRIPE_INTEGRATION_TODO.md.
STRIPE_SECRET_KEY="sk_test_..."

# Browser-safe Stripe publishable key, read by Vite at build time.
# Set this in Cloudflare Workers Builds environment variables and rebuild.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
